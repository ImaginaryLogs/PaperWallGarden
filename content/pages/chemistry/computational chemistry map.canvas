{
	"nodes":[
		{"id":"537c63440818939a","type":"group","x":-2980,"y":-4200,"width":5940,"height":3980,"label":"Computational Chemistry"},
		{"id":"faf02ed345d53551","type":"group","x":5960,"y":-2040,"width":4000,"height":2280,"label":"Quantum Algorithms for Quantum Chemistry and Quantum Materials Science"},
		{"id":"19e1eb98db982a4c","type":"group","x":5960,"y":300,"width":2314,"height":2060,"label":"Protein Structure Prediction Using Quantum Computers"},
